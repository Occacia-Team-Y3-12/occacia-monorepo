## Occacia backend local development
## Copy to backend/.env for local app and local Docker usage.

# Required
SECRET_KEY=replace_me
DB_USER=admin
DB_PASSWORD=replace_me
DB_NAME=occacia_db
DB_HOST=localhost
DB_PORT=5432

# Optional: direct connection string override.
# DATABASE_URL=postgresql+psycopg2://admin:replace_me@localhost:5432/occacia_db

# Optional (only needed for AI planning endpoints)
# LANGFLOW_URL=https://your-langflow-endpoint
# LANGFLOW_TOKEN=replace_me
# LANGFLOW_ORG_ID=replace_me

# Optional (required for Google Calendar integration)
# GOOGLE_CLIENT_ID=replace_me
# GOOGLE_CLIENT_SECRET=replace_me
# GOOGLE_REDIRECT_URI=https://app.occacia.com/oauth/callback
# GOOGLE_CALENDAR_SCOPES=openid email https://www.googleapis.com/auth/calendar.events https://www.googleapis.com/auth/calendar.readonly
# CALENDAR_TOKEN_ENCRYPTION_KEY=replace_me

# Optional
# REDIS_URL=redis://localhost:6379
# SKIP_EMAIL_VERIFICATION=false

# Notifications
# NOTIFICATION_AUTH_EMAILS_ONLY=true
# Comma-separated allowlist (overrides NOTIFICATION_AUTH_EMAILS_ONLY)
# NOTIFICATION_ALLOWED_TYPES=CUSTOMER_VERIFICATION,CUSTOMER_PASSWORD_RESET_LINK,VENDOR_VERIFICATION,VENDOR_PASSWORD_RESET_LINK,ADMIN_VERIFICATION,ADMIN_LOGIN_OTP,ADMIN_PASSWORD_RESET_OTP,TASK_CONFIRMED,DIRECT_EMAIL
